{%- assign cfg = app.metafields.mascot_config.config.value -%}
{%- if cfg != blank and cfg.enabled != false and cfg.phone != blank -%}
  {{ 'mascot.css' | asset_url | stylesheet_tag }}
  {%- assign img_uomo = 'mascotte-uomo.png' | asset_url -%}
  {%- assign img_donna = 'mascotte-donna.png' | asset_url -%}
  {%- assign img_rapper = 'mascotte-rapper.png' | asset_url -%}
  <div id="wcm-root" data-uomo="{{ img_uomo }}" data-donna="{{ img_donna }}" data-rapper="{{ img_rapper }}"></div>
  <script type="application/json" id="wcm-config">{{ cfg | json }}</script>
  <script src="{{ 'mascot.js' | asset_url }}" defer="defer"></script>
{%- elsif cfg == blank -%}
  <!-- wcm: no configuration found. new={{ app.metafields.mascot_config.config | json | truncate: 160 }} old={{ app.metafields.mascot.config | json | truncate: 160 }} -->
{%- elsif cfg.enabled == false -%}
  <!-- wcm: mascot disabled in the app settings -->
{%- else -%}
  <!-- wcm: WhatsApp number missing in the app settings -->
{%- endif -%}

{% schema %}
{
  "name": "Mascotte WhatsApp",
  "target": "body",
  "settings": []
}
{% endschema %}
